# Configuración del despliegue de Fitlosophy.
#
#   cp .env.example .env      y rellena los valores.
#
# El `.env` real está en .gitignore: contiene la contraseña del usuario único y
# la ruta de una BD con datos personales de salud. Nunca se versiona.
#
# Precedencia: variable de entorno ya definida > .env > valor por defecto.
# Un `FITLOSOPHY_DB=otra.db uvicorn ...` puntual sigue ganando sobre el fichero.

# --- Base de datos ----------------------------------------------------------
# Ruta del SQLite. Relativa a app/backend si no es absoluta.
FITLOSOPHY_DB=fitlosophy.db

# --- Escucha del servidor ---------------------------------------------------
# Las lee el servicio systemd (EnvironmentFile), no la aplicación: uvicorn las
# necesita antes de arrancar. 0.0.0.0 porque el servicio se consume desde la LAN
# y desde el contenedor de cloudflared (que llega al host por 172.17.0.1).
FITLOSOPHY_HOST=0.0.0.0
FITLOSOPHY_PORT=10012

# Peers autorizados a declarar la IP de origen con la cabecera CF-Connecting-IP.
# Con el puerto abierto en la LAN esto es lo que impide falsearla para esquivar
# el freno de fuerza bruta: solo se acepta del túnel y de loopback.
FITLOSOPHY_PROXIES_CONFIABLES=127.0.0.1,::1,172.17.0.0/16

# --- Usuario único (solo lo lee scripts/init_db.py) -------------------------
# No hay registro (docs/14): el usuario se crea una sola vez al inicializar la
# BD. Si ya existe, init_db.py no lo toca ni cambia la contraseña.
FITLOSOPHY_USER=cambiame
FITLOSOPHY_PASSWORD=cambiame

# --- Cookie de sesión -------------------------------------------------------
# auto (recomendado): Secure cuando la petición llega por HTTPS (el túnel) y sin
# Secure por HTTP (la LAN), porque el navegador descarta una cookie Secure
# servida por HTTP y el login no llegaría a funcionar. Acepta también true/false.
FITLOSOPHY_COOKIE_SECURE=auto

# --- Freno de fuerza bruta en el login --------------------------------------
# Fallos desde una misma IP que disparan el bloqueo.
FITLOSOPHY_LOGIN_MAX_INTENTOS=5
# Ventana de conteo, en minutos.
FITLOSOPHY_LOGIN_VENTANA_MIN=15
# Duración del primer bloqueo; se duplica por cada tanda de fallos en 24 h.
FITLOSOPHY_LOGIN_BLOQUEO_MIN=15
# Techo del bloqueo, en minutos.
FITLOSOPHY_LOGIN_BLOQUEO_MAX_MIN=60
# Fallos de TODAS las IPs juntas que frenan el login (ataque distribuido).
FITLOSOPHY_LOGIN_MAX_GLOBAL=50

# --- Purga del caché de Cloudflare (opcional) -------------------------------
# Solo las usa scripts/desplegar.sh. Sin ellas el despliegue funciona igual:
# los ficheros con hash no necesitan purga y el resto se sirve con no-cache.
# El token necesita el permiso «Zone / Cache Purge» sobre la zona.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
